#!/usr/bin/env bash
#
# xylo-installer — xyloOS interactive installation wizard (Arch Linux base)
#
# Flow: Language -> Wi-Fi/Network -> Region & Timezone -> User Account ->
#       Desktop Environment -> Target Drive -> Install
#
# Everything below is dialog-menu / dialog-select driven. Free text is only
# ever asked for username, password, and manual SSID/device entry as a
# fallback when auto-detection finds nothing.
#
# NOTE ON PACKAGE NAMES: these were written from best available knowledge
# of Arch's official repos, not verified against a live pacman database (no
# Arch mirror access in the environment that authored this). Every DE/WM
# selection below runs a `pacman -Si` availability check against your
# actual mirrors before installing anything, and tells you plainly if a
# package name needs correcting rather than failing silently mid-install.
#
set -uo pipefail

# Force a consistent, predictable locale for the whole script. Byte-range
# regex/pattern matching (used below to strip terminal escape sequences)
# and sed/grep behavior can vary subtly under different locales — this
# removes that variable entirely rather than hoping every string
# operation in this script happens to behave the same way it did in
# testing.
export LC_ALL=C

BOLD=$'\033[1m'; RESET=$'\033[0m'
CYAN=$'\033[1;36m'; GREEN=$'\033[1;32m'; RED=$'\033[1;31m'; YELLOW=$'\033[1;33m'
banner() { echo; printf '%s=== %s ===%s\n' "$BOLD$CYAN" "$*" "$RESET"; }
info()  { printf '%s[*]%s %s\n'  "$CYAN"   "$RESET" "$*"; }
ok()    { printf '%s[OK]%s %s\n' "$GREEN"  "$RESET" "$*"; }
warn()  { printf '%s[!]%s %s\n'  "$YELLOW" "$RESET" "$*"; }
err()   { printf '%s[ERROR]%s %s\n' "$RED" "$RESET" "$*"; }
die()   { err "$*"; exit 1; }
strip_ansi() { sed -r 's/\x1b\[[0-9;]*[a-zA-Z]//g'; }

require_root() { [[ $EUID -eq 0 ]] || die "Run as root."; }

trap 'echo; err "Interrupted."; exit 130' INT TERM

[[ -f /etc/xyloos/dialogrc ]] && export DIALOGRC=/etc/xyloos/dialogrc
HAVE_DIALOG=0
command -v dialog &>/dev/null && HAVE_DIALOG=1

# Strip carriage returns and leading/trailing whitespace from anything
# captured from dialog. On some terminals/hardware dialog's output can
# pick up trailing control characters that are invisible when printed
# but break exact string/case matching later — this was the root cause
# of desktop selection silently failing to match even a visually-correct
# choice like "gnome". Every dialog capture below is piped through this.
# Strip ANY ANSI/VT100 terminal escape sequence (ESC [ ... terminator)
# wherever it appears in a string, using only bash's own builtin regex
# engine — no external sed/grep call. Confirmed via a hex dump of a real
# failure that dialog's captured output can come back with terminal
# control codes stuck to the front of an otherwise completely correct
# selection (e.g. literal bytes ESC[@ ESC[J ESC[3J immediately before
# "gnome"). Two earlier fix attempts (removing dialog's --clear flag,
# then an external `sed -E` strip) both failed to actually stop this on
# the real hardware despite working in testing — moving to a pure-bash
# implementation removes any dependency on external tool behavior or
# locale-sensitive regex handling that could explain that gap.
strip_escapes() {
    local s="$1" esc
    esc=$(printf '\x1b')
    while [[ "$s" =~ ^([^$esc]*)$esc\[[0-9\;]*[@-~](.*)$ ]]; do
        s="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
    done
    printf '%s' "$s"
}

clean_choice() {
    local s="$1"
    s="$(strip_escapes "$s")"
    s="${s//$'\r'/}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Small helper: yes/no confirm, dialog when available, plain read as a
# last-resort fallback (only reachable if dialog is somehow missing).
confirm() {
    local prompt="$1"
    if [[ $HAVE_DIALOG -eq 1 ]]; then
        dialog --stdout --backtitle "xyloOS Installer" --title "Confirm" \
            --yesno "$prompt" 12 66
        local rc=$?
        clear
        [[ $rc -eq 0 ]] && return 0 || return 1
    fi
    local ans
    read -rp "$prompt [y/N] " ans
    [[ "$ans" =~ ^[Yy] ]]
}

# Small helper: single-line menu, dialog when available.
menu_pick() {
    # $1=title  $2=prompt  $3=height  $4=width  $5=menu-height  then tag/desc pairs...
    local title="$1" prompt="$2" h="$3" w="$4" mh="$5"; shift 5
    if [[ $HAVE_DIALOG -eq 1 ]]; then
        local out
        out=$(dialog --stdout --backtitle "xyloOS Installer" --title "$title" \
            --menu "$prompt" "$h" "$w" "$mh" "$@")
        clear
        printf '%s' "$(clean_choice "$out")"
        return 0
    fi
    return 1
}

TARGET_DISK=""
XYLO_USER=""
XYLO_PASS=""
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"
LANG_LABEL="English (US)"
DE_PKGS=""
DE_SERVICE=""
DE_LABEL="Minimal CLI Only"
DE_MODE="none"
WM_EXEC=""
BUILD_DWM_FROM_SOURCE=""

# ---------------------------------------------------------------------
# Step 1: Language
# ---------------------------------------------------------------------
step_lang() {
    banner "STEP 1: Language"
    local choice
    choice=$(menu_pick "Select Language" "Use Up/Down arrows and Enter to select:" 22 60 15 \
        "en_US" "English (US)" \
        "en_GB" "English (UK)" \
        "es_ES" "Espanol (Spanish)" \
        "fr_FR" "Francais (French)" \
        "de_DE" "Deutsch (German)" \
        "it_IT" "Italiano (Italian)" \
        "pt_BR" "Portugues (Brazil)" \
        "ru_RU" "Russian" \
        "ja_JP" "Japanese" \
        "zh_CN" "Chinese (Simplified)" \
        "ar_SA" "Arabic" \
        "hi_IN" "Hindi" \
        "ko_KR" "Korean" \
        "nl_NL" "Nederlands (Dutch)" \
        "pl_PL" "Polski (Polish)" \
        "tr_TR" "Turkce (Turkish)")

    case "$choice" in
        en_US) LOCALE="en_US.UTF-8"; LANG_LABEL="English (US)" ;;
        en_GB) LOCALE="en_GB.UTF-8"; LANG_LABEL="English (UK)" ;;
        es_ES) LOCALE="es_ES.UTF-8"; LANG_LABEL="Espanol (Spanish)" ;;
        fr_FR) LOCALE="fr_FR.UTF-8"; LANG_LABEL="Francais (French)" ;;
        de_DE) LOCALE="de_DE.UTF-8"; LANG_LABEL="Deutsch (German)" ;;
        it_IT) LOCALE="it_IT.UTF-8"; LANG_LABEL="Italiano (Italian)" ;;
        pt_BR) LOCALE="pt_BR.UTF-8"; LANG_LABEL="Portugues (Brazil)" ;;
        ru_RU) LOCALE="ru_RU.UTF-8"; LANG_LABEL="Russian" ;;
        ja_JP) LOCALE="ja_JP.UTF-8"; LANG_LABEL="Japanese" ;;
        zh_CN) LOCALE="zh_CN.UTF-8"; LANG_LABEL="Chinese (Simplified)" ;;
        ar_SA) LOCALE="ar_SA.UTF-8"; LANG_LABEL="Arabic" ;;
        hi_IN) LOCALE="hi_IN.UTF-8"; LANG_LABEL="Hindi" ;;
        ko_KR) LOCALE="ko_KR.UTF-8"; LANG_LABEL="Korean" ;;
        nl_NL) LOCALE="nl_NL.UTF-8"; LANG_LABEL="Nederlands (Dutch)" ;;
        pl_PL) LOCALE="pl_PL.UTF-8"; LANG_LABEL="Polski (Polish)" ;;
        tr_TR) LOCALE="tr_TR.UTF-8"; LANG_LABEL="Turkce (Turkish)" ;;
        *) LOCALE="en_US.UTF-8"; LANG_LABEL="English (US)" ;;
    esac
    ok "Language set to $LANG_LABEL"
}

# ---------------------------------------------------------------------
# Step 2: Wi-Fi / Network
# ---------------------------------------------------------------------
step_wifi() {
    banner "STEP 2: Network Connectivity"
    if ping -c1 -W2 archlinux.org &>/dev/null; then
        ok "Already online (wired connection or previously connected)."
        return 0
    fi

    # Try wired first — a plugged-in cable shouldn't force you through Wi-Fi.
    local ethdev
    ethdev=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^(en|eth)' | head -1)
    if [[ -n "$ethdev" ]]; then
        info "Trying DHCP on $ethdev..."
        ip link set "$ethdev" up 2>/dev/null
        timeout 10 dhcpcd -1 "$ethdev" &>/dev/null || timeout 10 dhclient -1 "$ethdev" &>/dev/null
        if ping -c1 -W2 archlinux.org &>/dev/null; then
            ok "Connected via $ethdev."
            return 0
        fi
    fi

    if ! command -v iwctl &>/dev/null; then
        warn "iwd/iwctl not available. Connect a wired cable and press Enter,"
        warn "or open a second console (Ctrl+Alt+F2) and connect manually."
        read -rp "Press Enter once you have a network connection: " _
        if ping -c1 -W2 archlinux.org &>/dev/null; then
            return 0
        fi
        warn "Still no internet access."
        return 1
    fi

    # iwctl's "device list" table is: Name  Address  Powered  Adapter  Mode
    # — interface name is field 1, NOT field 2 (that's the MAC address).
    local dev
    dev=$(iwctl device list 2>/dev/null | strip_ansi | awk '/station/{print $1; exit}')
    [[ -z "$dev" ]] && dev=$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')
    if [[ -z "$dev" ]]; then
        warn "No wireless interface auto-detected."
        read -rp "Enter your wireless device name manually (e.g. wlan0), or leave blank to skip Wi-Fi: " dev
        [[ -z "$dev" ]] && { warn "Skipping Wi-Fi. Ensure you have another connection."; return 1; }
    fi
    info "Using wireless device: $dev"

    while true; do
        info "Scanning for networks..."
        iwctl station "$dev" scan &>/dev/null
        sleep 4

        local uniq_list
        collect_ssids() {
            uniq_list=()
            local seen="" line ssid
            while IFS= read -r line; do
                line=$(printf '%s' "$line" | strip_ansi)
                ssid=$(printf '%s' "$line" | sed -E 's/^\s*[>*]?\s*//; s/\s{2,}.*$//')
                [[ -z "$ssid" || "$ssid" == "Network"* ]] && continue
                [[ "$seen" == *"|${ssid}|"* ]] && continue
                seen="${seen}|${ssid}|"
                uniq_list+=("$ssid")
            done < <(iwctl station "$dev" get-networks 2>/dev/null | tail -n +5)
        }
        collect_ssids
        if [[ ${#uniq_list[@]} -eq 0 ]]; then
            info "No networks found yet, scanning again..."
            iwctl station "$dev" scan &>/dev/null
            sleep 5
            collect_ssids
        fi

        local ssid=""
        if [[ ${#uniq_list[@]} -gt 0 && $HAVE_DIALOG -eq 1 ]]; then
            local menu_items=()
            for s in "${uniq_list[@]}"; do
                menu_items+=("$s" "")
            done
            menu_items+=("(Enter SSID manually)" "")
            ssid=$(dialog --stdout --backtitle "xyloOS Installer" \
                --title "Select Wi-Fi Network" \
                --menu "Use Up/Down arrows and Enter to select:" 20 60 12 \
                "${menu_items[@]}")
            ssid=$(clean_choice "$ssid")
            clear
            [[ "$ssid" == "(Enter SSID manually)" ]] && ssid=""
        fi

        if [[ -z "$ssid" && ${#uniq_list[@]} -eq 0 ]]; then
            warn "Could not find any networks automatically."
        fi
        if [[ -z "$ssid" ]]; then
            read -rp "Enter the SSID to connect to manually (blank to cancel): " ssid
        fi
        if [[ -z "$ssid" ]]; then
            warn "No network selected."
            if confirm "Try Wi-Fi setup again?"; then continue; else return 1; fi
        fi

        local pass
        if [[ $HAVE_DIALOG -eq 1 ]]; then
            pass=$(dialog --stdout --backtitle "xyloOS Installer" \
                --title "Wi-Fi Password" \
                --insecure --passwordbox "Password for '$ssid' (leave blank for open network):" 10 60 \
               )
            pass="$(strip_escapes "$pass")"
            pass="${pass//$'\r'/}"
            clear
        else
            read -rsp "Password for '$ssid' (blank = open network): " pass; echo
        fi

        info "Connecting to $ssid ..."
        if [[ -n "$pass" ]]; then
            iwctl --passphrase "$pass" station "$dev" connect "$ssid"
        else
            iwctl station "$dev" connect "$ssid"
        fi

        local linked=""
        for _ in 1 2 3 4 5 6; do
            if iwctl station "$dev" show 2>/dev/null | grep -qi "State.*connected"; then
                linked=1
                break
            fi
            sleep 1
        done
        if [[ -z "$linked" ]]; then
            err "Could not associate with '$ssid' — double-check the password."
            if confirm "Try again?"; then continue; else return 1; fi
        fi

        # iwd only brings up the wireless link; it does not request an IP.
        info "Requesting an IP address..."
        if command -v dhcpcd &>/dev/null; then
            timeout 15 dhcpcd -1 "$dev" &>/dev/null
        elif command -v dhclient &>/dev/null; then
            timeout 15 dhclient -1 "$dev" &>/dev/null
        else
            warn "No DHCP client found — cannot request an IP address automatically."
        fi

        sleep 1
        if ping -c1 -W3 archlinux.org &>/dev/null; then
            ok "Connected to the internet."
            return 0
        else
            err "Linked to '$ssid' but couldn't reach the internet (no IP address or no route)."
            if confirm "Try a different network?"; then continue; else return 1; fi
        fi
    done
}

# ---------------------------------------------------------------------
# Step 3: Region & Timezone
# ---------------------------------------------------------------------
step_timezone() {
    banner "STEP 3: Region & Timezone"
    mapfile -t regions < <(find /usr/share/zoneinfo -mindepth 1 -maxdepth 1 -type d \
        -printf '%f\n' | grep -Ev '^(posix|right|Etc|SystemV)$' | sort)

    local region=""
    if [[ $HAVE_DIALOG -eq 1 ]]; then
        local menu_items=()
        for r in "${regions[@]}"; do
            menu_items+=("$r" "")
        done
        region=$(dialog --stdout --backtitle "xyloOS Installer" \
            --title "Select Region" \
            --menu "Use Up/Down arrows and Enter to select:" 22 50 15 \
            "${menu_items[@]}")
        region=$(clean_choice "$region")
        clear
    fi
    [[ -n "$region" ]] || die "No region selected."

    mapfile -t cities < <(find "/usr/share/zoneinfo/$region" -type f -printf '%f\n' | sort)
    local city=""
    if [[ $HAVE_DIALOG -eq 1 ]]; then
        local menu_items=()
        for c in "${cities[@]}"; do
            menu_items+=("$c" "")
        done
        city=$(dialog --stdout --backtitle "xyloOS Installer" \
            --title "Select City / Timezone ($region)" \
            --menu "Use Up/Down arrows and Enter to select:" 22 60 15 \
            "${menu_items[@]}")
        city=$(clean_choice "$city")
        clear
    fi
    [[ -n "$city" ]] || die "No timezone selected."

    TIMEZONE="$region/$city"
    timedatectl set-ntp true 2>/dev/null || true
    ok "Timezone set to $TIMEZONE (clock will sync via NTP)."
}

# ---------------------------------------------------------------------
# Step 4: User account
# ---------------------------------------------------------------------
step_user() {
    banner "STEP 4: User Account"
    while true; do
        if [[ $HAVE_DIALOG -eq 1 ]]; then
            XYLO_USER=$(dialog --stdout --backtitle "xyloOS Installer" --title "User Account" \
                --inputbox "Choose a username (lowercase, no spaces):" 10 60 \
               )
            XYLO_USER=$(clean_choice "$XYLO_USER")
            clear
        else
            read -rp "Choose a username: " XYLO_USER
        fi
        [[ "$XYLO_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] && break
        warn "Usernames must be lowercase, start with a letter/underscore, no spaces."
    done
    while true; do
        local pw1 pw2
        if [[ $HAVE_DIALOG -eq 1 ]]; then
            pw1=$(dialog --stdout --backtitle "xyloOS Installer" --title "Password" \
                --insecure --passwordbox "Enter password for $XYLO_USER:" 10 60 \
               )
            pw1="$(strip_escapes "$pw1")"
            pw1="${pw1//$'\r'/}"
            clear
            pw2=$(dialog --stdout --backtitle "xyloOS Installer" --title "Password" \
                --insecure --passwordbox "Confirm password:" 10 60 \
               )
            pw2="$(strip_escapes "$pw2")"
            pw2="${pw2//$'\r'/}"
            clear
        else
            read -rsp "Enter password: " pw1; echo
            read -rsp "Confirm password: " pw2; echo
        fi
        if [[ -z "$pw1" ]]; then warn "Password cannot be empty."
        elif [[ "$pw1" != "$pw2" ]]; then warn "Passwords did not match, try again."
        else XYLO_PASS="$pw1"; break; fi
    done
    ok "User '$XYLO_USER' will be created with sudo privileges."
}

# ---------------------------------------------------------------------
# Step 5: Desktop environment / window manager
# ---------------------------------------------------------------------
step_de() {
    banner "STEP 5: Desktop Environment / Window Manager"

    local choice="" attempts=0
    while true; do
        choice=$(menu_pick "Desktop Environment / Window Manager" \
            "Use Up/Down arrows and Enter to select:" 23 66 16 \
            "gnome"      "GNOME (GDM)" \
            "kde"        "KDE Plasma (SDDM)" \
            "xfce"       "Xfce (LightDM)" \
            "mate"       "MATE (LightDM)" \
            "cinnamon"   "Cinnamon (LightDM)" \
            "lxqt"       "LXQt (SDDM)" \
            "lxde"       "LXDE (LightDM)" \
            "budgie"     "Budgie (LightDM)" \
            "hyprland"   "Hyprland (Wayland tiling WM)" \
            "sway"       "Sway (Wayland tiling WM)" \
            "i3"         "i3 (X11 tiling WM)" \
            "bspwm"      "bspwm (X11 tiling WM)" \
            "awesome"    "Awesome (X11 tiling WM)" \
            "xmonad"     "Xmonad (X11 tiling WM)" \
            "herbstluftwm" "herbstluftwm (X11 tiling WM)" \
            "dwm"        "dwm (X11 tiling WM)" \
            "none"       "Minimal CLI Only (no desktop)")

        if [[ -z "$choice" && $HAVE_DIALOG -ne 1 ]]; then
            cat <<'MENU'
  [1]  GNOME            [2]  KDE Plasma       [3]  Xfce
  [4]  MATE             [5]  Cinnamon         [6]  LXQt
  [7]  LXDE             [8]  Budgie           [9]  Hyprland
  [10] Sway             [11] i3               [12] bspwm
  [13] Awesome          [14] Xmonad           [15] herbstluftwm
  [16] dwm              [17] Minimal CLI Only
MENU
            local n
            read -rp "Choose [1-17]: " n
            local names=(gnome kde xfce mate cinnamon lxqt lxde budgie hyprland sway i3 bspwm awesome xmonad herbstluftwm dwm none)
            choice="${names[$((n-1))]:-}"
        fi

        case "$choice" in
            gnome|kde|xfce|mate|cinnamon|lxqt|lxde|budgie|hyprland|sway|i3|bspwm|awesome|xmonad|herbstluftwm|dwm|none|"")
                break
                ;;
            *)
                ((attempts++))
                if [[ $attempts -ge 3 ]]; then
                    die "Unrecognized desktop selection. Raw hex bytes of what was captured: [$(printf '%s' "$choice" | od -An -tx1 | tr -s ' \n' ' ')] (length ${#choice} chars) — tell Claude this exact bracketed hex string."
                fi
                warn "Unrecognized selection (hex: [$(printf '%s' "$choice" | od -An -tx1 | tr -s ' \n' ' ')]). Please try again (attempt ${attempts}/3)."
                ;;
        esac
    done

    # DE_MODE: "dm" (has a display manager) / "wm-x11" / "wm-wayland" / "none"
    DE_MODE="dm"
    WM_EXEC=""
    local XORG_BASE="xorg-server xorg-xinit xterm"
    case "$choice" in
        gnome)    DE_PKGS="gnome-shell gnome-control-center nautilus gnome-terminal gdm"; DE_SERVICE="gdm"; DE_LABEL="GNOME" ;;
        kde)      DE_PKGS="plasma-desktop sddm konsole dolphin"; DE_SERVICE="sddm"; DE_LABEL="KDE Plasma" ;;
        xfce)     DE_PKGS="xfce4 xfce4-goodies lightdm lightdm-gtk-greeter"; DE_SERVICE="lightdm"; DE_LABEL="Xfce" ;;
        mate)     DE_PKGS="mate mate-extra lightdm lightdm-gtk-greeter"; DE_SERVICE="lightdm"; DE_LABEL="MATE" ;;
        cinnamon) DE_PKGS="cinnamon lightdm lightdm-gtk-greeter"; DE_SERVICE="lightdm"; DE_LABEL="Cinnamon" ;;
        lxqt)     DE_PKGS="lxqt sddm"; DE_SERVICE="sddm"; DE_LABEL="LXQt" ;;
        lxde)     DE_PKGS="lxde lightdm lightdm-gtk-greeter"; DE_SERVICE="lightdm"; DE_LABEL="LXDE" ;;
        budgie)   DE_PKGS="budgie-desktop lightdm lightdm-gtk-greeter"; DE_SERVICE="lightdm"; DE_LABEL="Budgie" ;;
        hyprland)
            DE_MODE="wm-wayland"
            DE_PKGS="hyprland kitty waybar dunst"; WM_EXEC="Hyprland"; DE_LABEL="Hyprland"
            ;;
        sway)
            DE_MODE="wm-wayland"
            DE_PKGS="sway foot waybar dunst"; WM_EXEC="sway"; DE_LABEL="Sway"
            ;;
        i3)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE i3-wm i3status i3lock dmenu rofi feh picom"
            WM_EXEC="exec i3"; DE_LABEL="i3"
            ;;
        bspwm)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE bspwm sxhkd rofi feh picom"
            WM_EXEC=$'sxhkd &\nexec bspwm'; DE_LABEL="bspwm"
            ;;
        awesome)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE awesome"
            WM_EXEC="exec awesome"; DE_LABEL="Awesome"
            ;;
        xmonad)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE xmonad xmonad-contrib"
            WM_EXEC="exec xmonad"; DE_LABEL="Xmonad"
            ;;
        herbstluftwm)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE herbstluftwm"
            WM_EXEC="exec herbstluftwm"; DE_LABEL="herbstluftwm"
            ;;
        dwm)
            DE_MODE="wm-x11"
            DE_PKGS="$XORG_BASE dmenu base-devel git libx11 libxinerama libxft"
            WM_EXEC="exec dwm"; DE_LABEL="dwm (built from source)"
            BUILD_DWM_FROM_SOURCE=1
            ;;
        none|"") DE_MODE="none"; DE_PKGS=""; DE_SERVICE=""; DE_LABEL="Minimal CLI Only" ;;
    esac
    ok "Desktop selection: $DE_LABEL"
}

# ---------------------------------------------------------------------
# Step 6: Target drive (last step before install)
# ---------------------------------------------------------------------
step_disk() {
    banner "STEP 6: Target Installation Drive"
    echo

    # Never let the boot medium itself show up as an install target.
    # archiso mounts the live medium at /run/archiso/bootmnt.
    local boot_part boot_disk
    boot_part=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)
    if [[ -n "$boot_part" ]]; then
        boot_disk=$(lsblk -no PKNAME "$boot_part" 2>/dev/null)
    fi

    declare -gA disk_map=()
    local i=1 d size model
    mapfile -t disks < <(lsblk -dn -e7,11 -o NAME,TYPE,SIZE | awk '$2=="disk" && $3!="0B"{print $1}')
    [[ ${#disks[@]} -gt 0 ]] || die "No storage drives detected."

    local menu_items=()
    for d in "${disks[@]}"; do
        if [[ -n "$boot_disk" && "$d" == "$boot_disk" ]]; then
            continue
        fi
        size=$(lsblk -dn -o SIZE "/dev/$d")
        model=$(lsblk -dn -o MODEL "/dev/$d" 2>/dev/null)
        menu_items+=("/dev/$d" "$size  $model")
        disk_map[$i]="/dev/$d"
        ((i++))
    done
    if [[ -n "$boot_disk" ]]; then
        info "(/dev/$boot_disk — your xyloOS boot drive — is hidden from this list for safety)"
    fi
    [[ ${#menu_items[@]} -gt 0 ]] || die "No installable drives found (only the boot USB was detected)."

    local attempts=0
    while true; do
        TARGET_DISK=""
        if [[ $HAVE_DIALOG -eq 1 ]]; then
            TARGET_DISK=$(dialog --stdout --backtitle "xyloOS Installer" \
                --title "Select Target Drive" \
                --menu "Use Up/Down arrows and Enter to select. ALL DATA on the chosen drive will be erased." \
                18 60 8 "${menu_items[@]}")
            TARGET_DISK=$(clean_choice "$TARGET_DISK")
            clear
        fi
        [[ -n "$TARGET_DISK" ]] && break
        ((attempts++))
        if [[ $attempts -ge 3 ]]; then
            die "No drive was selected after ${attempts} attempts (dialog kept returning empty — if you were pressing Cancel/Esc, that's why; otherwise this points to a real bug, tell Claude)."
        fi
        warn "No drive selected. Please try again (attempt ${attempts}/3)."
    done

    if ! confirm "ALL DATA ON $TARGET_DISK WILL BE PERMANENTLY ERASED.\n\nErase $TARGET_DISK and continue?"; then
        die "Cancelled — nothing was erased."
    fi
    ok "Target drive set to $TARGET_DISK"
}

# ---------------------------------------------------------------------
# Post-selection automation
# ---------------------------------------------------------------------
step_install() {
    banner "Partitioning $TARGET_DISK"
    wipefs -af "$TARGET_DISK" || true
    parted -s "$TARGET_DISK" mklabel gpt
    parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 513MiB
    parted -s "$TARGET_DISK" set 1 esp on
    parted -s "$TARGET_DISK" mkpart primary ext4 513MiB 100%
    partprobe "$TARGET_DISK" 2>/dev/null || true
    sleep 1

    local esp root
    if [[ "$TARGET_DISK" =~ nvme|mmcblk ]]; then
        esp="${TARGET_DISK}p1"; root="${TARGET_DISK}p2"
    else
        esp="${TARGET_DISK}1"; root="${TARGET_DISK}2"
    fi

    info "Formatting $esp as FAT32 (EFI System Partition)..."
    mkfs.fat -F32 "$esp"
    info "Formatting $root as ext4 (root)..."
    mkfs.ext4 -F "$root"

    mount "$root" /mnt
    mkdir -p /mnt/boot/efi
    mount "$esp" /mnt/boot/efi

    # Verify every package in the selected set actually exists on your
    # mirrors before committing to the install — this is the safety net
    # for the package-name uncertainty noted at the top of this script.
    if [[ -n "$DE_PKGS" ]]; then
        info "Checking package availability for $DE_LABEL..."
        pacman -Sy &>/dev/null
        local missing=()
        for pkg in $DE_PKGS; do
            pacman -Si "$pkg" &>/dev/null || missing+=("$pkg")
        done
        if [[ ${#missing[@]} -gt 0 ]]; then
            err "These packages were not found on your mirrors: ${missing[*]}"
            warn "Package names can drift over time — check https://archlinux.org/packages/"
            warn "for the current name and edit DE_PKGS in this script, or continue"
            warn "and the base system will still install without this desktop."
            if confirm "Continue with base install only (no desktop)?"; then
                DE_PKGS=""; DE_MODE="none"; DE_SERVICE=""; DE_LABEL="Minimal CLI Only (packages unavailable)"
            else
                die "Aborting so you can fix the package list."
            fi
        fi
    fi

    banner "Installing base system (pacstrap — downloads over your network)"
    # shellcheck disable=SC2086
    pacstrap -K /mnt base linux linux-firmware sudo networkmanager iwd \
        grub efibootmgr os-prober vim nano dialog fastfetch \
        mesa vulkan-icd-loader \
        $DE_PKGS \
        || die "pacstrap failed. Check network connectivity and retry."

    genfstab -U /mnt >> /mnt/etc/fstab

    echo "xyloos" > /mnt/etc/hostname
    cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
127.0.1.1   xyloos
::1         localhost ip6-localhost ip6-loopback
EOF

    # Carry the ASCII logo + fastfetch config from the live medium onto
    # the target, and rebrand the installed system itself (not just the
    # live ISO) so it actually identifies as xyloOS once installed.
    if [[ -d /etc/xyloos ]]; then
        mkdir -p /mnt/etc/xyloos /mnt/etc/skel/.config/fastfetch /mnt/root/.config/fastfetch
        cp -r /etc/xyloos/. /mnt/etc/xyloos/ 2>/dev/null || true
        [[ -f /etc/xdg/fastfetch/config.jsonc ]] && { mkdir -p /mnt/etc/xdg/fastfetch; cp /etc/xdg/fastfetch/config.jsonc /mnt/etc/xdg/fastfetch/; }
        [[ -f /etc/skel/.config/fastfetch/config.jsonc ]] && cp /etc/skel/.config/fastfetch/config.jsonc /mnt/etc/skel/.config/fastfetch/
        [[ -f /root/.config/fastfetch/config.jsonc ]] && cp /root/.config/fastfetch/config.jsonc /mnt/root/.config/fastfetch/
    fi

    banner "Configuring the installed system"
    # arch-chroot (from arch-install-scripts) bind-mounts /dev, /proc,
    # /sys (including efivars), /run, and copies resolv.conf automatically
    # — this sidesteps the manual-bind-mount efivars pitfall entirely.
    arch-chroot /mnt /bin/bash <<CHROOT
set -e
ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc

echo "${LOCALE} UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=${LOCALE}" > /etc/locale.conf

cat > /etc/os-release <<'OSEOF'
NAME="xyloOS"
PRETTY_NAME="xyloOS"
ID=xyloos
ID_LIKE=arch
VERSION="1.0"
ANSI_COLOR="1;36"
OSEOF
echo "xyloOS \\n \\l" > /etc/issue

useradd -m -G wheel -s /bin/bash "${XYLO_USER}"
echo "${XYLO_USER}:${XYLO_PASS}" | chpasswd
passwd -l root
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers

if [[ "${BUILD_DWM_FROM_SOURCE}" == "1" ]]; then
    mkdir -p /usr/local/src
    cd /usr/local/src
    git clone https://git.suckless.org/dwm
    cd dwm
    make clean install
    cd /
fi

# No Plymouth splash on the installed system either — same Arch-branding
# risk applies here as on the live ISO (see build.sh's CHANGELOG). Arch's
# default GRUB config boots "quiet" out of the box; without a splash to
# show in its place that means a genuinely blank screen with zero
# feedback, so this explicitly drops "quiet" here to keep boot text
# visible instead.
if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub; then
    sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3"/' /etc/default/grub
else
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3"' >> /etc/default/grub
fi

mkinitcpio -P

systemctl enable NetworkManager
if [[ "${DE_MODE}" == "dm" && -n "${DE_SERVICE}" ]]; then
    systemctl enable "${DE_SERVICE}" || true
elif [[ "${DE_MODE}" == "wm-x11" || "${DE_MODE}" == "wm-wayland" ]]; then
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'AUTOEOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin ${XYLO_USER} --noclear %I \$TERM
AUTOEOF

    if [[ "${DE_MODE}" == "wm-x11" ]]; then
        cat > /home/${XYLO_USER}/.bash_profile <<'PROFEOF'
if [[ -z "\${DISPLAY}" && "\$(tty)" == "/dev/tty1" ]]; then
    exec startx
fi
PROFEOF
        cat > /home/${XYLO_USER}/.xinitrc <<'XINITEOF'
${WM_EXEC}
XINITEOF
    else
        cat > /home/${XYLO_USER}/.bash_profile <<'PROFEOF'
if [[ -z "\${WAYLAND_DISPLAY}" && -z "\${DISPLAY}" && "\$(tty)" == "/dev/tty1" ]]; then
    exec ${WM_EXEC}
fi
PROFEOF
    fi
    chown "${XYLO_USER}:${XYLO_USER}" "/home/${XYLO_USER}/.bash_profile"
    [[ -f "/home/${XYLO_USER}/.xinitrc" ]] && chown "${XYLO_USER}:${XYLO_USER}" "/home/${XYLO_USER}/.xinitrc"
fi

if command -v fastfetch &>/dev/null; then
    cat >> /etc/bash.bashrc <<'FFEOF'

# xyloOS: show system info banner on interactive shell login
if [[ \$- == *i* ]] && [[ -z "\$XYLOOS_FASTFETCH_SHOWN" ]] && command -v fastfetch &>/dev/null; then
    export XYLOOS_FASTFETCH_SHOWN=1
    fastfetch
fi
FFEOF
fi

if [[ -d /sys/firmware/efi ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=xyloOS
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable
else
    grub-install --target=i386-pc "${TARGET_DISK}"
fi
grub-mkconfig -o /boot/grub/grub.cfg
CHROOT
    local rc=$?
    [[ $rc -eq 0 ]] || die "System configuration inside chroot failed."

    umount -R /mnt
    ok "xyloOS installation complete."
}

# ---------------------------------------------------------------------
# Main flow
# ---------------------------------------------------------------------
main() {
    require_root
    clear
    cat <<'BANNER'
                             @@@@@@@@@@@@                             
                          @@@@@@@@@@@@@@@@@@@@@@                        
                        @@@@@@@@@@@@@@@@@@@@@@@@@@@                     
                     @@@@@@@@@@@@@@........@@@@@@@@@@                   
                    @@@@@@@@@@@@...............@@@@@@@@                 
                  @@@@@@@@@@@@......@@@@@@@@@@@=.@@@@@@@                
                 @@@@@.@@@@@.....@@@@@@@@@@@@@@@@@@@@@@@@               
                @@@@@..@@@@@...@@@@@@@@@@@@@@@@@@@@@@@@@@@              
               .@@@@:.@@@@@...@@@@@@@@@@@@@@@@@@@@@@@@@@@@@             
               @@@@@..@@@@@..@@@@@@@............@@@@@@@@@@@.            
              .@@@@...@@@@@.@@@@@@................@@@@@@@@@.            
              @@@@@...@@@@@@@@@@....................@@@@@@@@.           
              @@@@@....@@@@@@@@.........       ......@@@@@@%.           
              .@@@@....@@@@@@@@......            ....@@@@@@..           
              .@@@@@....@@@@@@.....               ...@@@@@@..           
              ..@@@@.....+@@@@.....                ..@@@@@...           
              ..@@@@@......@@@@...                 ..@@@@@...           
               ..@@@@@........@@..                 ..@@@@...            
               ...@@@@@...........                 .@@@@....            
                ...@@%@@..........                @@@@@....             
                 ...@@@@@@. .....                @@@@@....              
                  ....@@*@@@@@                @@%@@@.....               
                    ....@@@+.@@@@@        @@@@@#@@......                
                     ......@@@@=.=@@@@@@@@@@@@@.......                  
                       ........*@@@@@@@@@@@.........                    
                          .......................                       
                              ................                          

                     xyloOS Installation Wizard
BANNER
    sleep 1

    step_lang

    while ! step_wifi; do
        echo
        warn "Wi-Fi setup did not complete."
        if confirm "Try Wi-Fi setup again?"; then
            continue
        else
            warn "Continuing without confirmed internet access."
            warn "The install step later on needs internet to fetch packages,"
            warn "so make sure you have a wired connection before proceeding."
            break
        fi
    done
    step_timezone
    step_user
    step_de
    step_disk

    banner "Ready to Install"
    if ! confirm "Language      : $LANG_LABEL\nTimezone      : $TIMEZONE\nUsername      : $XYLO_USER\nDesktop       : $DE_LABEL\nTarget drive  : $TARGET_DISK\n\nTHIS ERASES $TARGET_DISK.\n\nProceed with installation?"; then
        die "Installation cancelled by user."
    fi

    step_install

    echo
    if confirm "Installation finished. Reboot now?"; then
        reboot
    fi
}

main "$@"
